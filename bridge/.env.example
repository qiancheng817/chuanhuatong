# ===== 小米账号（小爱音箱）=====
MI_USER=你的小米账号
MI_PASS=你的小米密码
# 音箱 deviceID / 名称 / 序列号均可；留空使用账号下第一台小爱音箱
MI_DID=客厅小爱音箱
# 若登录触发两步验证：把收到的验证码填到这里重启（或写入挂载目录的 otp.txt）
MI_OTP=

# ===== 企业微信智能机器人（管理后台创建，选择「长连接」模式）=====
WECOM_BOT_ID=你的Bot ID
WECOM_BOT_SECRET=你的Bot Secret

# ===== Songloft 传话筒插件 =====
# 插件基础地址（注意末尾不要带 /）
SONGLOFT_PLUGIN_URL=http://192.168.1.100:58091/api/v1/jsplugin/chuanhuatong
# 与插件配置页中一致的共享密钥
BRIDGE_TOKEN=请改成一串随机字符串

# ===== 可选 =====
POLL_INTERVAL=3
BRIDGE_PORT=8788
